GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# USD per million tokens; check https://ai.google.dev/gemini-api/docs/pricing
PRICE_INPUT_PER_M=1.50
PRICE_OUTPUT_PER_M=7.50
# optional security and privacy settings
API_TOKEN=
RETENTION_DAYS=0
# OCR for photos/scans, and what the model receives for them: vision, ocr or hybrid
OCR_ENABLED=true
EXTRACTION_ROUTE=vision
# hosted database + files on Supabase (leave empty for local SQLite and local files)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents
